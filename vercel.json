{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "web/dist",
  "redirects": [
    {
      "source": "/sistema/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/web/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'sha256-8DVzh0iqjsDeLxh57I19wmjc0O3WiIEvRg3NXhmc+JI=' 'sha256-uwrb8c6VsDupyg1xISAXVs/+yk8+D5WQQ5IJ2CfRsx0=' 'sha256-A0k9EM/C8NaydhZq+Y/Y6aCP7Hnh3bC1wlIWrAHLTpQ=' 'sha256-T45aRHzgo8YIpTqHN1wrmgFmSMywsIIbOmzSeu+3TbU='; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
